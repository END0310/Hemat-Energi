# Port tempat server Express berjalan
PORT=3000

# Konfigurasi koneksi database MySQL (XAMPP / Laragon / MySQL Server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hemat_energi

# Kunci rahasia tanda tangan token JWT (jangan pernah di-commit ke Git)
